{
  "name": "next-turn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "archive:runs": "node --import tsx scripts/archive_runs.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx scripts/serve_frontend.ts",
    "dev:chat": "node --import tsx scripts/serve_chat.ts",
    "example:playwright": "node --import tsx examples/playwright-task1.ts",
    "run:weekend1": "node --import tsx scripts/run_weekend1.ts",
    "run:weekend3": "node --import tsx scripts/run_weekend3.ts",
    "review:weekend3": "node --import tsx scripts/record_weekend3_review.ts",
    "run:tau2:openrouter": "bash scripts/run_tau2_openrouter.sh",
    "setup:tau2": "bash scripts/setup_tau2.sh",
    "smoke:openrouter": "node --env-file-if-exists=.env --import tsx scripts/smoke_openrouter.ts",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:tau2": "bash scripts/validate_tau2_task_1.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.5.33",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  }
}
